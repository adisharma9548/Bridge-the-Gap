# ==============================================================================
# SETU - Production & Local Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Node.js + Express)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Database (PostgreSQL Connection String or discrete credentials)
# Example: postgres://postgres:postgres@localhost:5432/setu_db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/setu_db
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=setu_db

# Google Gemini API
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
DAILY_GEMINI_LIMIT=500

# Open Government Data Platform India (data.gov.in)
# Register and obtain API key at: https://data.gov.in/
DATA_GOV_API_KEY=your_datagov_api_key_here

# Client URL for CORS
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite + React)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api
